# ============================================================
# AWS GenAI TCO & ROI Analyst - Chatbot UI Configuration
# ============================================================
# Copy this file to .env and replace REPLACE_ME values with
# your actual deployment values from the CloudFormation stack outputs.

# --- AWS Region ---
AWS_REGION=us-west-2
REACT_APP_AWS_REGION=us-west-2

# --- Cognito Configuration ---
# Get these from your Cognito User Pool (created externally)
REACT_APP_COGNITO_USER_POOL_ID=REPLACE_ME
REACT_APP_COGNITO_CLIENT_ID=REPLACE_ME
REACT_APP_COGNITO_DOMAIN=REPLACE_ME

# --- CloudFront / Redirect URL ---
# Get CloudFrontURL from CFN stack outputs
REACT_APP_REDIRECT_URL=https://your-cloudfront-domain.cloudfront.net/

# --- Cognito Identity Pool ---
# Get IdentityPoolId from CFN stack outputs
REACT_APP_IDENTITY_POOL_ID=REPLACE_ME

# --- AgentCore Runtime ARN (optional, auto-discovered if not set) ---
# AGENTCORE_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-west-2:123456789012:runtime/your-agent-id

# --- Server Ports ---
PORT=3000
SERVER_PORT=3001
