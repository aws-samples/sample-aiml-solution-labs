{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "GenAiTcoRoiTool",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "MyAgent"
  },
  "runtimes": [
    {
      "name": "AnalystAgent",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/AnalystAgent/",
      "runtimeVersion": "PYTHON_3_12",
      "envVars": [
        {
          "name": "STRANDS_KNOWLEDGE_BASE_ID",
          "value": "ZKPRZMJQZX"
        },
        {
          "name": "MEMORY_ID",
          "value": "AmazonGenAiTcoRoiTool_LessonsLearned-NWXSeHCPkG"
        }
      ],
      "networkMode": "PUBLIC",
      "protocol": "HTTP"
    }
  ],
  "memories": [
    {
      "name": "LessonsLearned",
      "eventExpiryDuration": 7,
      "strategies": [
        {
          "type": "EPISODIC",
          "namespaces": [
            "/episodes/{actorId}/{sessionId}"
          ],
          "reflectionNamespaces": [
            "/episodes"
          ]
        }
      ]
    }
  ],
  "credentials": [],
  "evaluators": [
    {
      "name": "KBInvokeEvaluation",
      "level": "TOOL_CALL",
      "config": {
        "llmAsAJudge": {
          "model": "global.anthropic.claude-opus-4-5-20251101-v1:0",
          "instructions": "Evaluate the tool call. Context: {context}. Tool turn: {tool_turn}. Rate the quality of this tool usage. When querying knowledge base, the query should be precise, applying exact context including model versions or AWS region parameters.",
          "ratingScale": {
            "numerical": [
              {
                "value": 1,
                "label": "Poor",
                "definition": "Fails to meet expectations"
              },
              {
                "value": 2,
                "label": "Fair",
                "definition": "Partially meets expectations"
              },
              {
                "value": 3,
                "label": "Good",
                "definition": "Meets expectations"
              },
              {
                "value": 4,
                "label": "Very Good",
                "definition": "Exceeds expectations"
              },
              {
                "value": 5,
                "label": "Excellent",
                "definition": "Far exceeds expectations"
              }
            ]
          }
        }
      }
    }
  ],
  "onlineEvalConfigs": [
    {
      "name": "MyOnlineEval",
      "agent": "AnalystAgent",
      "evaluators": [
        "arn:aws:bedrock-agentcore:::evaluator/Builtin.Correctness",
        "arn:aws:bedrock-agentcore:::evaluator/Builtin.Helpfulness",
        "arn:aws:bedrock-agentcore:::evaluator/Builtin.ResponseRelevance",
        "arn:aws:bedrock-agentcore:::evaluator/Builtin.Conciseness",
        "arn:aws:bedrock-agentcore:::evaluator/Builtin.Coherence",
        "arn:aws:bedrock-agentcore:::evaluator/Builtin.InstructionFollowing",
        "arn:aws:bedrock-agentcore:::evaluator/Builtin.ToolSelectionAccuracy",
        "arn:aws:bedrock-agentcore:::evaluator/Builtin.ToolParameterAccuracy"
      ],
      "samplingRate": 100,
      "enableOnCreate": true
    }
  ],
  "agentCoreGateways": [],
  "policyEngines": []
}
