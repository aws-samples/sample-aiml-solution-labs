// Generated by Terraform (terraform/ui.tf from terraform/identity.tf).
// Non-secret IdP settings for the SPA — one shape for every provider.
//
//   provider "cognito" -> uses region + userPoolId + clientId + domainPrefix
//                         (Hosted UI authorization-code flow)
//   provider "auth0"   -> uses domain + clientId
//                         (auth0-spa-js, loaded on demand)
//   provider "none"    -> enabled is false; the UI runs with NO authentication
//
// Unused fields for the selected provider are intentionally empty strings.
window.AUTH_CONFIG = {
  enabled: ${enabled},
  provider: "${provider}",

  // Cognito
  region: "${region}",
  userPoolId: "${user_pool_id}",
  domainPrefix: "${domain_prefix}",

  // Auth0
  domain: "${domain}",

  // Both (the SPA / app client id)
  clientId: "${client_id}"
};
