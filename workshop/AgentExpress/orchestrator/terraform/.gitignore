# Per-account backend wiring, generated by bootstrap-state.sh. Holds the state
# bucket name for YOUR account — never commit it.
backend.hcl

# Terraform working dir + provider plugins (large; re-created by `terraform init`).
.terraform/

# Local state. Once bootstrap-state.sh has run, state lives in S3 — these are
# only the pre-migration leftovers/backups.
terraform.tfstate
terraform.tfstate.*
*.tfstate
*.tfstate.*

# Tenant-specific variable values (the example file IS committed).
terraform.tfvars

# Saved plans and build artifacts.
tfplan
*.tfplan
.build/
# Written by deployer/runner.py inside CodeBuild; never committed.
zz_builder_backend_override.tf
builder.auto.tfvars.json
