# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Node
node_modules/

# CDK build output (regenerated by `cdk synth`; also stages copies of app/)
cdk.out/
.cdk.staging/

# Terraform: provider cache, state and plans. State can hold resource
# attributes, and a plan file holds the whole diff — neither belongs in git.
.terraform/
*.tfstate
*.tfstate.*
tfplan
*.tfplan

# Local deploy config. terraform.tfvars.example is the tracked template;
# the real file names an account's own choices and stays local.
terraform.tfvars

# Local env / secrets — never commit these
.env
*.creds.env

# Build/run logs
*.log

# Editor
.idea/
.vscode/

# Demo recordings are hosted outside the repository
*.mp4

# Local working folders: agent task notes, git worktrees, and a stale local copy
# of the repo at the root
.agents/
.worktrees/
/agentexpress/
