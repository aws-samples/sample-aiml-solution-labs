.DS_Store

# CDK build output (synthesized templates + asset staging) — regenerated on deploy
**/cdk.out/
**/cdk.out.*/
**/cdk-outputs.json
**/cdk.context.json

# Python
**/__pycache__/
*.pyc
**/.ruff_cache/

# One-shot local operator / review scripts — not part of the app; run by hand,
# imported by nothing. Not shipped.
app/server/redeploy_layer5.py
app/server/redeploy_layer6.py
app/cdk/nag_report.py

# Office lock/temp files (the ~$ prefix) — always junk
**/~$*

# Node
**/node_modules/

# Deploy/runtime state (local, account-specific)
**/logs/
**/state.json

# Local secrets/config — never commit; .env.example is the committed template
**/.env
!**/.env.example

# DemoStudio artifacts — generated by the recorder; all live under
# DemoStudio/workspaces/ now, but ignore any stragglers that land here too.
.demo-studio/
demo-out/
# demo-studio.json is the DemoStudio recorder config — it belongs to the recorder, not
# the security demo, so it's not shipped/scanned with this repo (DemoStudio keeps its own).
demo-studio.json

# Presenter demo scripts + generated PPTX/arch artifacts — local presenter aids, not shipped.
demo-script/

# Duplicated goal-fence shim — not part of the sample
app/agent-layer6/iris_goalfence/

# app/docs/ — the three console-served "how it works" explainers (/docs/obo-flow,
# /docs/memory-flow, /docs/goal-fence) AND the generic Okta setup guide (placeholders
# only, no secrets/org-specific IDs; linked from the README) ARE committed. Anything
# else here (personal reference pages) is a local aid and stays ignored.
app/docs/*
!app/docs/obo-flow-explainer.html
!app/docs/memory-flow-explainer.html
!app/docs/goal-fence-explainer.html
!app/docs/okta-setup.md

.holmes
/holmes/*
