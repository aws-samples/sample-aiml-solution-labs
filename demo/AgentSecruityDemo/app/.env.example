# Copy to .env and fill with your Okta org's real values. The .env file is gitignored;
# this .env.example is committed as the template. Real env vars set in your shell
# override anything here.
#
# Non-secret identifiers (from your Okta admin console):
OKTA_DOMAIN=https://<your-okta-org>.okta.com
OKTA_AGENT_AUTH_SERVER_ID=<iris-agent-auth-server-id>
OKTA_GATEWAY_AUTH_SERVER_ID=<iris-gateway-auth-server-id>
OKTA_LOGIN_CLIENT_ID=<iris-login-client-id>
OKTA_SUPPORT_DELEGATE_CLIENT_ID=<iris-support-delegate-client-id>
OKTA_ADMIN_DELEGATE_CLIENT_ID=<iris-admin-delegate-client-id>

# Secrets — REQUIRED, no default (the server fails loud without them). Never commit real values.
OKTA_LOGIN_CLIENT_SECRET=
OKTA_SUPPORT_DELEGATE_CLIENT_SECRET=
OKTA_ADMIN_DELEGATE_CLIENT_SECRET=
